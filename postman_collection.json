{
  "info": {
    "name": "IsoArch LR4 — cookie sessions",
    "description": "Сценарий для тестовой БД, все значения указаны явно, без переменных. Cookie jar и вкладка Authorization отключены: сессия передаётся только строкой Headers Cookie: session_id=<UUID>. После запроса 4 скопируйте UUID из Set-Cookie и вставьте его вместо 00000000-0000-0000-0000-000000000000 во всех запросах с Cookie. После запроса 7 замените 0 в URL на ID созданного черновика. Логин lr4_postman_student можно зарегистрировать один раз; при 409 выполните сразу вход. Working directory: корень репозитория.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "protocolProfileBehavior": {
    "disableCookies": true
  },
  "item": [
    {
      "name": "1. Публичный список без сессии",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8000/services?c13_max=-15"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Guest flags\", () => pm.response.json().forEach(s => { pm.expect(s.status).to.eql(\"published\"); pm.expect(s.is_creator).to.eql(0); }));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "2. Черновик гостю запрещён",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8000/services/draft"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "3. Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8000/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"lr4_postman_student\", \"password\": \"StudyPassword123\", \"full_name\": \"Исследователь ЛР4\", \"email\": \"lr4_postman_student@example.org\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Password hidden\", () => pm.expect(pm.response.json()).not.to.have.property(\"password\"));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "4. Вход; скопировать Set-Cookie для ручной демонстрации",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8000/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"lr4_postman_student\", \"password\": \"StudyPassword123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const cookie = pm.response.headers.get(\"Set-Cookie\");",
              "const match = cookie && cookie.match(/session_id=([^;]+)/);",
              "pm.test(\"Session cookie and HttpOnly\", () => { pm.expect(match).not.to.eql(null); pm.expect(cookie).to.include(\"HttpOnly\"); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "5. Текущий пользователь — ручной Cookie Header",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id=00000000-0000-0000-0000-000000000000",
            "description": "Замените нули на UUID из Set-Cookie ответа входа (без session_id=, атрибутов и кавычек)."
          }
        ],
        "url": "http://localhost:8000/auth/me",
        "description": "Замените нули на UUID из Set-Cookie ответа входа (без session_id=, атрибутов и кавычек)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Session identity\", () => pm.expect(pm.response.json().username).to.eql(\"lr4_postman_student\"));"
            ]
          }
        }
      ],
      "response": []
    },
