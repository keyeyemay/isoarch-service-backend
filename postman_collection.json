{
  "info": {
    "name": "IsoArch LR4 — cookie sessions",
    "description": "Последовательный сценарий на тестовой БД. В Settings коллекции отключён cookie jar: после login UUID сохраняется в session_id и явно передаётся через Headers Cookie: session_id={{session_id}}. Для ручного показа скопируйте UUID из Set-Cookie. Working directory: корень репозитория.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "protocolProfileBehavior": {
    "disableCookies": true
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "service_id",
      "value": ""
    },
    {
      "key": "feed_id",
      "value": ""
    },
    {
      "key": "registration_suffix",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Публичный список без сессии",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/services?c13_max=-15"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Guest flags\", () => pm.response.json().forEach(s => { pm.expect(s.status).to.eql(\"published\"); pm.expect(s.is_creator).to.eql(0); }));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "2. Черновик гостю запрещён",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/services/draft"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "3. Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"lr4_{{registration_suffix}}\", \"password\": \"StudyPassword123\", \"full_name\": \"Исследователь ЛР4\", \"email\": \"lr4_{{registration_suffix}}@example.org\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"registration_suffix\", pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Password hidden\", () => pm.expect(pm.response.json()).not.to.have.property(\"password\"));",
              "pm.collectionVariables.set(\"user_id\", pm.response.json().id);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "4. Вход; скопировать Set-Cookie для ручной демонстрации",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"lr4_{{registration_suffix}}\", \"password\": \"StudyPassword123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const cookie = pm.response.headers.get(\"Set-Cookie\");",
              "const match = cookie && cookie.match(/session_id=([^;]+)/);",
              "pm.test(\"Session cookie and HttpOnly\", () => { pm.expect(match).not.to.eql(null); pm.expect(cookie).to.include(\"HttpOnly\"); });",
              "if (match) pm.collectionVariables.set(\"session_id\", match[1]);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "5. Текущий пользователь — ручной Cookie Header",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          }
        ],
        "url": "{{base_url}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Session identity\", () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get(\"user_id\"))));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "6. Черновик отсутствует",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          }
        ],
        "url": "{{base_url}}/services/draft"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No draft\", () => pm.expect(pm.response.json()).to.eql(null));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "7. Создать с бинарными фото и видео",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          }
        ],
        "url": "{{base_url}}/services",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Исследование ЛР4",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "static/images/default_signature.png"
            },
            {
              "key": "video",
              "type": "file",
              "src": "static/videos/default_signature.mp4"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"service_id\", pm.response.json().id);",
              "pm.test(\"Object names\", () => pm.expect(pm.response.json().image_file).to.match(/^[a-f0-9]{32}\\.png$/));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "8. Свой черновик по сессии",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          }
        ],
        "url": "{{base_url}}/services/draft"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Own draft\", () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get(\"service_id\"))));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "9. Публикация",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/services/{{service_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"description\": \"Изотопный анализ: смешанный рацион\", \"delta_n15\": 9.4, \"delta_c13\": -18.2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Author from session\", () => { const s=pm.response.json(); pm.expect(s.is_creator).to.eql(1); pm.expect(String(s.creator_id)).to.eql(String(pm.collectionVariables.get(\"user_id\"))); pm.expect(s.status).to.eql(\"published\"); });",
              "pm.collectionVariables.set(\"formed_at\", pm.response.json().formed_at);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "9a. Обновление опубликованной записи",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/services/{{service_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Обновлённое исследование\", \"description\": \"Уточнённый рацион\", \"delta_n15\": 10.5, \"delta_c13\": -19}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Updated publication\", () => { const s=pm.response.json(); pm.expect(s.title).to.eql(\"Обновлённое исследование\"); pm.expect(s.description).to.eql(\"Уточнённый рацион\"); pm.expect(s.formed_at).to.eql(pm.collectionVariables.get(\"formed_at\")); pm.expect(s.status).to.eql(\"published\"); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "10. Публичная лента",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/services/feed"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"feed_id\", pm.response.json().id);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "11. Следующая запись",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/services/feed/{{feed_id}}?next=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "12. Лайк",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/services/{{service_id}}/like",
        "body": {
          "mode": "raw",
          "raw": "{\"like\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Like value\", () => pm.expect(pm.response.json().like).to.eql(1));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "13. Снять лайк",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/services/{{service_id}}/like",
        "body": {
          "mode": "raw",
          "raw": "{\"like\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Like value\", () => pm.expect(pm.response.json().like).to.eql(0));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "14. Soft delete",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          }
        ],
        "url": "{{base_url}}/services/{{service_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Empty response\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "15. Удалённая запись скрыта",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/services/feed/{{service_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "16. Выход и отзыв сессии",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          }
        ],
        "url": "{{base_url}}/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Cookie cleared\", () => pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"Max-Age=0\"));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "17. Отозванная сессия не работает",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}"
          }
        ],
        "url": "{{base_url}}/services/draft"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
