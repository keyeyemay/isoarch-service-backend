{
  "info": {
    "name": "ЛР4 — показ 1–9: Swagger, Postman, Redis, StarUML",
    "description": "Сначала войдите через Swagger в инкогнито. Все значения заданы явно, без переменных. Скопируйте UUID из Application/Cookies и вставьте вместо 00000000-0000-0000-0000-000000000000 в Headers всех запросов с Cookie; после «Подготовка B/C» замените 0 в URL на ID своего черновика. Cookie jar отключён. Запросы запускайте по одному, выход выполняйте только ПОСЛЕ показа Redis. Для файлов выберите static/images/default_signature.png и static/videos/default_signature.mp4. Номера 4–8 соответствуют скриншотам Postman. Скриншоты 1–3 выполняются в браузере, 9 — в StarUML; Redis показывается отдельно.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "protocolProfileBehavior": {
    "disableCookies": true
  },
  "item": [
    {
      "name": "Подготовка A. Проверить cookie из Swagger",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id=00000000-0000-0000-0000-000000000000",
            "description": "Замените нули на UUID из Set-Cookie ответа входа (без session_id=, атрибутов и кавычек)."
          }
        ],
        "url": "http://localhost:8000/auth/me",
        "auth": {
          "type": "noauth"
        },
        "description": "Замените нули на UUID из Set-Cookie ответа входа (без session_id=, атрибутов и кавычек)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Подготовка B. Создать собственный черновик",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id=00000000-0000-0000-0000-000000000000",
            "description": "Замените нули на UUID из Set-Cookie ответа входа (без session_id=, атрибутов и кавычек)."
          }
        ],
        "url": "http://localhost:8000/services",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Исследование для демонстрации ЛР4",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "static/images/default_signature.png"
            },
            {
              "key": "video",
              "type": "file",
              "src": "static/videos/default_signature.mp4"
            }
          ]
        },
        "description": "Замените нули на UUID из Set-Cookie ответа входа (без session_id=, атрибутов и кавычек)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
