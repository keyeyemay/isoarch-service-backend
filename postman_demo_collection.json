{
  "info": {
    "name": "ЛР4 — показ 1–9: Swagger, Postman, Redis, StarUML",
    "description": "Сначала войдите через Swagger в инкогнито. Вставьте UUID из Application/Cookies в session_id вручную. Cookie jar отключён. Запросы запускайте по одному, выход выполняйте только ПОСЛЕ показа Redis. Для файлов выберите static/images/default_signature.png и static/videos/default_signature.mp4. Номера 4–8 соответствуют скриншотам Postman. Скриншоты 1–3 выполняются в браузере, 9 — в StarUML; Redis показывается отдельно.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "protocolProfileBehavior": {
    "disableCookies": true
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "service_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Подготовка A. Проверить cookie из Swagger",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}",
            "disabled": false
          }
        ],
        "url": "{{base_url}}/auth/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"user_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Подготовка B. Создать собственный черновик",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}",
            "disabled": false
          }
        ],
        "url": "{{base_url}}/services",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Исследование для демонстрации ЛР4",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "static/images/default_signature.png"
            },
            {
              "key": "video",
              "type": "file",
              "src": "static/videos/default_signature.mp4"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"service_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Подготовка C. Получить ID существующего черновика (если POST вернул 409)",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}",
            "disabled": false
          }
        ],
        "url": "{{base_url}}/services/draft",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const draft=pm.response.json(); if (draft) pm.collectionVariables.set(\"service_id\", draft.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Все опубликованные услуги — БЕЗ cookie",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/services",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Guest flags\", () => pm.response.json().forEach(s => pm.expect(s.is_creator).to.eql(0)));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Все опубликованные услуги — С cookie",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}",
            "disabled": false
          }
        ],
        "url": "{{base_url}}/services",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Дополнительно. Все опубликованные услуги — НЕВЕРНАЯ cookie",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id=invalid-demo-session",
            "disabled": false
          }
        ],
        "url": "{{base_url}}/services",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. PUT гостя — отказ 401",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/services/{{service_id}}",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Опубликовано через Postman\",\n  \"description\": \"Смешанный рацион. Демонстрация публикации.\",\n  \"delta_n15\": 9.4,\n  \"delta_c13\": -18.2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. PUT автора — публикация 200",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}",
            "disabled": false
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/services/{{service_id}}",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Опубликовано через Postman\",\n  \"description\": \"Смешанный рацион. Демонстрация публикации.\",\n  \"delta_n15\": 9.4,\n  \"delta_c13\": -18.2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Published by current user\", () => { const s=pm.response.json(); pm.expect(s.status).to.eql(\"published\"); pm.expect(s.is_creator).to.eql(1); pm.expect(String(s.creator_id)).to.eql(String(pm.collectionVariables.get(\"user_id\"))); });",
              "pm.test(\"Fields updated\", () => { const s=pm.response.json(); pm.expect(s.title).to.eql(\"Опубликовано через Postman\"); pm.expect(s.delta_n15).to.eql(9.4); pm.expect(s.delta_c13).to.eql(-18.2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. PUT автора — повторное обновление 200",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}",
            "disabled": false
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/services/{{service_id}}",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Опубликовано через Postman\",\n  \"description\": \"Уточнённый рацион после публикации.\",\n  \"delta_n15\": 10.5,\n  \"delta_c13\": -18.2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Updated after publication\", () => { const s=pm.response.json(); pm.expect(s.description).to.eql(\"Уточнённый рацион после публикации.\"); pm.expect(s.delta_n15).to.eql(10.5); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Дополнительно. Проверить сохранённую публикацию",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id={{session_id}}",
            "disabled": false
          }
        ],
        "url": "{{base_url}}/services/feed/{{service_id}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
