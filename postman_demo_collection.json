        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Published by current user\", () => { const s=pm.response.json(); pm.expect(s.status).to.eql(\"published\"); pm.expect(s.is_creator).to.eql(1); });",
              "pm.test(\"Fields updated\", () => { const s=pm.response.json(); pm.expect(s.title).to.eql(\"Опубликовано через Postman\"); pm.expect(s.delta_n15).to.eql(9.4); pm.expect(s.delta_c13).to.eql(-18.2); });"
            ]
          }
        }
      ]
    },
